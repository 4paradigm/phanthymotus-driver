# Copy to .env and set device paths for this machine.
# Keep receiver and hand RS485 devices different. Do not commit the filled file.
L20_LITE_IMAGE=local/phanthy-l20-lite:sdkfree
GLOVE_SERIAL_PORT=/dev/serial/by-path/REPLACE_WITH_GLOVE_RECEIVER
L20_SERIAL_PORT=/dev/serial/by-path/REPLACE_WITH_HAND_RS485
