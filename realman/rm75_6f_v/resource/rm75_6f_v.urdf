<?xml version="1.0"?>
<!-- Mesh-free RM75-6F-V kinematic model.  The frame origins and rotations
     follow the official RealMan RM75-6F model; simple links keep the model
     portable in Canvas where only the skeleton is needed. -->
<robot name="RM75-6F-V">
  <link name="base_link"/>
  <link name="link_1"/><link name="link_2"/><link name="link_3"/>
  <link name="link_4"/><link name="link_5"/><link name="link_6"/>
  <link name="link_7"/><link name="tool0"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.2405" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.106" upper="3.106" effort="100" velocity="3.14"/>
  </joint>
  <!-- The display model uses a straight zero pose.  RM75 controller joint
       angles are already expressed in the controller's zero reference; the
       alternating physical frame rotations must not be applied as visible
       bends by Canvas. -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="link_2"/>
    <origin xyz="0 0 0.256" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.269" upper="2.269" effort="100" velocity="3.14"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/><child link="link_3"/>
    <origin xyz="0 0 0.210" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.106" upper="3.106" effort="100" velocity="3.14"/>
  </joint>
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/><child link="link_4"/>
    <origin xyz="0 0 0.1725" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.356" upper="2.356" effort="100" velocity="3.14"/>
  </joint>
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/><child link="link_5"/>
    <origin xyz="0 0 0.150" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.106" upper="3.106" effort="100" velocity="3.14"/>
  </joint>
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/><child link="link_6"/>
    <origin xyz="0 0 0.120" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.234" upper="2.234" effort="100" velocity="3.14"/>
  </joint>
  <joint name="joint_7" type="revolute">
    <parent link="link_6"/><child link="link_7"/>
    <origin xyz="0 0 0.100" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-6.283" upper="6.283" effort="100" velocity="3.14"/>
  </joint>
  <joint name="tool0_fixed" type="fixed">
    <parent link="link_7"/><child link="tool0"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>
</robot>
