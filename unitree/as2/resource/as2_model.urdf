<?xml version="1.0"?>
<robot name="unitree_as2">
  <link name="base"/>
  <link name="imu_link"/>
  <joint name="imu_fixed" type="fixed"><parent link="base"/><child link="imu_link"/><origin xyz="0 0 0.08"/></joint>
  <link name="fl_hip"/><link name="fl_thigh"/><link name="fl_calf"/><link name="fr_hip"/><link name="fr_thigh"/><link name="fr_calf"/>
  <link name="rl_hip"/><link name="rl_thigh"/><link name="rl_calf"/><link name="rr_hip"/><link name="rr_thigh"/><link name="rr_calf"/>
  <joint name="fl_hip_joint" type="revolute"><parent link="base"/><child link="fl_hip"/><limit lower="-1.57" upper="1.57" effort="33" velocity="20"/></joint>
  <joint name="fl_thigh_joint" type="revolute"><parent link="fl_hip"/><child link="fl_thigh"/><limit lower="-2.6" upper="2.6" effort="33" velocity="20"/></joint>
  <joint name="fl_calf_joint" type="revolute"><parent link="fl_thigh"/><child link="fl_calf"/><limit lower="-2.6" upper="-0.4" effort="33" velocity="20"/></joint>
  <joint name="fr_hip_joint" type="revolute"><parent link="base"/><child link="fr_hip"/><limit lower="-1.57" upper="1.57" effort="33" velocity="20"/></joint>
  <joint name="fr_thigh_joint" type="revolute"><parent link="fr_hip"/><child link="fr_thigh"/><limit lower="-2.6" upper="2.6" effort="33" velocity="20"/></joint>
  <joint name="fr_calf_joint" type="revolute"><parent link="fr_thigh"/><child link="fr_calf"/><limit lower="-2.6" upper="-0.4" effort="33" velocity="20"/></joint>
  <joint name="rl_hip_joint" type="revolute"><parent link="base"/><child link="rl_hip"/><limit lower="-1.57" upper="1.57" effort="33" velocity="20"/></joint>
  <joint name="rl_thigh_joint" type="revolute"><parent link="rl_hip"/><child link="rl_thigh"/><limit lower="-2.6" upper="2.6" effort="33" velocity="20"/></joint>
  <joint name="rl_calf_joint" type="revolute"><parent link="rl_thigh"/><child link="rl_calf"/><limit lower="-2.6" upper="-0.4" effort="33" velocity="20"/></joint>
  <joint name="rr_hip_joint" type="revolute"><parent link="base"/><child link="rr_hip"/><limit lower="-1.57" upper="1.57" effort="33" velocity="20"/></joint>
  <joint name="rr_thigh_joint" type="revolute"><parent link="rr_hip"/><child link="rr_thigh"/><limit lower="-2.6" upper="2.6" effort="33" velocity="20"/></joint>
  <joint name="rr_calf_joint" type="revolute"><parent link="rr_thigh"/><child link="rr_calf"/><limit lower="-2.6" upper="-0.4" effort="33" velocity="20"/></joint>
</robot>
