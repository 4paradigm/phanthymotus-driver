{
  "product": "BrainCo Revo 2 仿生灵巧手",
  "variants": {
    "basic": {
      "code": "XRL/XRR",
      "interfaces": ["RS485", "CANFD"],
      "supply_voltage_v": [12, 28],
      "touch": false
    },
    "pro": {
      "code": "XEL/XER",
      "interfaces": ["RS485", "CANFD", "EtherCAT"],
      "supply_voltage_v": [12, 64],
      "touch": false
    },
    "touch": {
      "code": "XTL/XTR",
      "interfaces": ["RS485", "CANFD", "EtherCAT"],
      "supply_voltage_v": [12, 64],
      "touch": true,
      "touch_hardware_types": [
        "Revo2Touch",
        "Revo2TouchPressure",
        "Revo2TouchForce3D",
        "Revo2TouchArrayPressure"
      ]
    }
  },
  "dof": {
    "active_joints": 6,
    "total_dof": 11,
    "note": "拇指2主动(内收外展+屈伸)+1被动屈伸；其余四指各1主动屈伸+1被动屈伸"
  },
  "joint_ranges_deg": {
    "thumb_flex": [0, 59],
    "thumb_aux": [0, 90],
    "index": [0, 81],
