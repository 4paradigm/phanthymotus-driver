#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import TwistStamped

class CmdVelRelayNode(Node):
    def __init__(self):
        super().__init__('era_nav_cmd_relay_node')

        # 订阅 /era_nav/cmd_vel 主题，接收 TwistStamped 类型的消息
        self.subscriber = self.create_subscription(
            TwistStamped,  # 订阅的消息类型
            '/era_nav/cmd_vel',  # 原始 topic
            self.listener_callback,
            10
        )

        # 创建发布者，发布到 /wr1_base_drive_controller/cmd_vel 主题
        self.publisher = self.create_publisher(
            TwistStamped,  # 发布的消息类型
            '/wr1_base_drive_controller/cmd_vel',  # 转发目标 topic
            10
        )

        # 初始化转发计数器
        self.forward_count = 0

        # 启动时打印提示信息
        self.get_logger().info('Starting to relay /era_nav/cmd_vel to /wr1_base_drive_controller/cmd_vel')

    def listener_callback(self, msg):
        # 将接收到的消息发布到目标 topic
        self.publisher.publish(msg)

        # 获取线速度（linear.x）和角速度（angular.z）
        linear_velocity = msg.twist.linear.x
        angular_velocity = msg.twist.angular.z

        # 增加转发计数器
        self.forward_count += 1

        # 打印转发信息，包括线速度、角速度以及转发次数
        self.get_logger().info(f'Relayed message {self.forward_count}: '
                               f'Linear Velocity: {linear_velocity} m/s, '
                               f'Angular Velocity: {angular_velocity} rad/s')

def main(args=None):
    rclpy.init(args=args)
    node = CmdVelRelayNode()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
