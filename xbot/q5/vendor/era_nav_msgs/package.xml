<?xml version="1.0" encoding="UTF-8"?>
<package format="3">
  <name>era_nav_msgs</name>
  <version>0.0.0</version>
  <description>Defines custom message, service, and action types for navigation functionality.</description>

  <maintainer email="zhiwei.wang@robotera.com">Jeffrey</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interface generators -->
  <depend>rosidl_default_generators</depend>

  <!-- Common message dependencies -->
  <depend>builtin_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Runtime for generated interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Add this line -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
