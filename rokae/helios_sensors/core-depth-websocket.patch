+class _LatestFrameQueue(asyncio.Queue):
+    """Hold one pending frame per browser and replace it on backpressure."""
+
+    def __init__(self):
+        super().__init__(maxsize=1)
+
+    def put_nowait(self, frame):
+        if self.full():
+            self.get_nowait()
+            self.task_done()
+        super().put_nowait(frame)
